/* lib.lds - linker script for the fwsiglib ed25519 verify library.
 *
 * The library is a flat RWX blob loaded by the boot ROM at a fixed
 * address in the SPRAM (see build/fllib.inc, generated by
 * rom/tools/make_lib_inc.py); LMA == VMA (no PIC, no relocations - the ROM
 * copies it byte-for-byte and the trampoline in rom/libcall.S jumps to
 * its absolute address).
 *
 * Loaded to [0x17800, 0x1E000), between the firmware image (which must
 * end by 0x17800, enforced by firmware/support/sections.lds) and the
 * ROM/firmware stack (which starts at 0x20000 and may use the gap
 * [0x1E000, 0x20000) plus whatever remains above the library).
 *
 * This library is linked with --gc-sections, so only the verify path
 * is included in the final binary. Resulting size is ~23 kB.
 *
 * The library must not use .bss: nothing in this system zeroes it for
 * the library (checked by the build).
 */
MEMORY {
    RAM (xrw) : ORIGIN = 0x17800, LENGTH = 0x6800
}

ENTRY(fk_lib_verify)

SECTIONS {
    .text :
    {
        _ltext = .;
        *(.text)
        *(.text*)
        *(.rodata)
        *(.rodata*)
        *(.srodata)
        *(.srodata*)
        . = ALIGN(4);
        _ltext_end = .;
    } >RAM

    .data :
    {
        . = ALIGN(4);
        _sdata = .;
        *(.data)
        *(.data*)
        *(.sdata)
        *(.sdata*)
        . = ALIGN(4);
        _edata = .;
    } >RAM

    .bss (NOLOAD) :
    {
        _sbss = .;
        *(.bss)
        *(.bss*)
        *(.sbss)
        *(.sbss*)
        *(COMMON)
        . = ALIGN(4);
        _ebss = .;
    } >RAM

    _lend = .;
}
